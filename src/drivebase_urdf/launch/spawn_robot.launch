<launch>
  <!-- Use the Gazebo physics engine -->
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="use_sim_time" default="true"/>

  <!-- Start Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>

  <!-- Load the robot URDF -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find drivebase_urdf)/urdf/drivebase.urdf'" />

  <!-- Generate the robot TF transforms -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Spawn the robot in Gazebo -->
  <node name="spawn_robot" pkg="gazebo_ros" type="spawn_model" args="-param robot_description -urdf -model drivebase" />

  <!-- Odometry TF -->
  <node pkg="tf" type="static_transform_publisher" name="odom_tf"
        args="0 0 0 0 0 0 odom base_link 100" />

  <!-- Odometry filter (optional) -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization">
    <rosparam command="load" file="$(find drivebase_urdf)/config/ekf.yaml"/>
  </node>

</launch>
