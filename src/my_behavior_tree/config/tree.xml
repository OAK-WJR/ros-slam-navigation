<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Auto">
      <!-- 1. First set the goal point to Point1 and move to point 1 -->
      <SetBlackboard output_key="target" value="Point1"/>
      <MoveToGoal goal="{target}"/>

      <!-- 2. Place the item -->
      <PutCoral/>

      <!-- 3. Pick-up branch -->
      <Fallback name="PickCoral">
        <!-- Branch 1: after a successful pick-up, set the goal to Point2 and move -->
        <Sequence name="SuccessPath">
          <SetBlackboard output_key="target" value="Point2"/>
          <MoveToGoal goal="{target}"/>
        </Sequence>
        <!-- Branch 2: after a failed pick-up, try picking up again, then set the goal to Point3 and move -->
        <Sequence name="FailurePath">
          <PickCoral/>
          <SetBlackboard output_key="target" value="Point3"/>
          <MoveToGoal goal="{target}"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AutoLineUp">
        <input_port name="goal"/>
    </Action>
    <Action ID="MoveToGoal">
        <input_port name="goal"/>
    </Action>
    <Action ID="PickCoral"/>
    <Action ID="PlaceCoral">
        <input_port name="level"/>
    </Action>
    <Action ID="PutCoral"/>
</TreeNodesModel>
</root>
