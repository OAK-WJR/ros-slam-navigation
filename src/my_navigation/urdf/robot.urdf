<?xml version="1.0"?>
<robot name="example_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================= -->
  <!-- Main body (bottom at z=0)     -->
  <!-- ============================= -->
  <link name="base_link">
    <!-- Inertia (example values) -->
    <inertial>
      <origin xyz="0.069 0 0.13675" rpy="0 0 0"/>
      <!--
        xyz set to (0.069,0,0.11185),
        meaning the geometric center of the whole box (body length 0.138/2=0.069)
        and height 0.2237/2=0.11185,
        so the "inertia center" lines up with the "geometric center".
        If later simulation does not need to be this strict, just use xyz="0 0 0".
      -->
      <mass value="2.0"/>                 <!-- 2 kg, example -->
      <inertia ixx="0.02" ixy="0.0" ixz="0.0"
               iyy="0.02" iyz="0.0"
               izz="0.02"/>
    </inertial>

    <!-- Visual (box) -->
    <visual>
      <!-- Body shape: length 0.138 × width 0.0835 × height 0.2237 (m) -->
      <origin xyz="0.069 0 0.13675" rpy="0 0 0"/>
      <geometry>
        <box size="0.138 0.0835 0.2237"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>

    <!-- Collision model (same as the visual) -->
    <collision>
      <origin xyz="0.069 0 0.13675" rpy="0 0 0"/>
      <geometry>
        <box size="0.138 0.0835 0.2237"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================= -->
  <!-- Left drive wheel              -->
  <!-- ============================= -->
  <link name="left_wheel_link">
    <inertial>
      <!-- Simplifying assumption: the wheel's center of mass matches its geometric center -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>

    <visual>
      <!-- Wheel: diameter 65mm => radius=0.0325m, width=0.0075m -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <!-- rpy="0 1.5708 0" points the cylinder axis along the y axis (i.e. horizontal); the default cylinder axis is z -->
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
    </collision>
  </link>

  <!-- Left drive wheel joint: continuous (can rotate without limit) -->
  <joint name="left_wheel_joint" type="continuous">
    <!-- Wheel center coordinates: x=0.05, y=-0.05375, z=0.033
         Axis along the y axis (0,1,0)
    -->
    <origin xyz="0.05 -0.05375 0.033" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- ============================= -->
  <!-- Right drive wheel             -->
  <!-- ============================= -->
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <!-- Wheel center coordinates: x=0.05, y=+0.05375, z=0.033
         Axis along the y axis (0,1,0)
    -->
    <origin xyz="0.05 0.05375 0.033" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- ============================= -->
  <!-- Passive caster ball (assumed radius=0.02m) -->
  <!-- ============================= -->
  <link name="caster_ball_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0"
               izz="0.00005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Passive wheel joint: if simplified to a fixed joint, use fixed; to simulate a real caster, set up complex constraints separately.
       This example just uses fixed.
       x=0.133 (0.133m forward from the rear edge), y=0, keep the ball touching the ground z=0 => ball center z=0.02
  -->
  <joint name="caster_joint" type="fixed">
    <origin xyz="0.133 0 0.02" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_ball_link"/>
  </joint>

  <!-- ============================= -->
  <!-- Lidar (assumed cylinder shape) -->
  <!-- ============================= -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>

    <visual>
      <!-- Simply use a cylinder for the lidar; this example assumes height=0.05m, radius=0.03m, etc. -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Lidar joint: fixed at a point on top of the body (x=0.055, y=0, z=0.2737) -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.055 0 0.2737" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

</robot>
