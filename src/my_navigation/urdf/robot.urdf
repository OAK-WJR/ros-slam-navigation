<?xml version="1.0"?>
<robot name="example_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================= -->
  <!-- 机身主体（底面位于 z=0）     -->
  <!-- ============================= -->
  <link name="base_link">
    <!-- 惯性（示例数值） -->
    <inertial>
      <origin xyz="0.069 0 0.13675" rpy="0 0 0"/>
      <!--
        xyz设为(0.069,0,0.11185)，
        表示整个box几何中心 (机身长0.138/2=0.069)
        和高0.2237/2=0.11185 处,
        这样“惯性中心”与“几何中心”对齐。
        若后续仿真不需要这么严格，可直接xyz="0 0 0"。
      -->
      <mass value="2.0"/>                 <!-- 2 kg，示例 -->
      <inertia ixx="0.02" ixy="0.0" ixz="0.0"
               iyy="0.02" iyz="0.0"
               izz="0.02"/>
    </inertial>

    <!-- 可视化（box） -->
    <visual>
      <!-- 机身外形：长 0.138 × 宽 0.0835 × 高 0.2237 (m) -->
      <origin xyz="0.069 0 0.13675" rpy="0 0 0"/>
      <geometry>
        <box size="0.138 0.0835 0.2237"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>

    <!-- 碰撞模型（与可视化一致） -->
    <collision>
      <origin xyz="0.069 0 0.13675" rpy="0 0 0"/>
      <geometry>
        <box size="0.138 0.0835 0.2237"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================= -->
  <!-- 左驱动轮                      -->
  <!-- ============================= -->
  <link name="left_wheel_link">
    <inertial>
      <!-- 简化假设，轮子的质心与几何中心重合 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>

    <visual>
      <!-- 轮子: 直径 65mm => 半径=0.0325m, 宽=0.0075m -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <!-- rpy="0 1.5708 0" 将圆柱轴指向 y 轴(即水平)；默认圆柱轴为 z -->
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
    </collision>
  </link>

  <!-- 左驱动轮关节：continuous (可无限旋转) -->
  <joint name="left_wheel_joint" type="continuous">
    <!-- 轮子中心坐标：x=0.05, y=-0.05375, z=0.033
         轴沿y轴 (0,1,0)
    -->
    <origin xyz="0.05 -0.05375 0.033" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- ============================= -->
  <!-- 右驱动轮                      -->
  <!-- ============================= -->
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.0075"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <!-- 轮子中心坐标：x=0.05, y=+0.05375, z=0.033
         轴沿y轴 (0,1,0)
    -->
    <origin xyz="0.05 0.05375 0.033" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <transmission name="right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- ============================= -->
  <!-- 被动万向球（假设半径=0.02m）   -->
  <!-- ============================= -->
  <link name="caster_ball_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0"
               izz="0.00005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- 被动轮关节：若仅简化为固定关节，可使用 fixed；想模拟真实万向，可另行设置复杂约束。
       这里示例直接 fixed。
       x=0.133 (后缘到前 0.133m), y=0, 让球紧贴地面 z=0 => 球心z=0.02
  -->
  <joint name="caster_joint" type="fixed">
    <origin xyz="0.133 0 0.02" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_ball_link"/>
  </joint>

  <!-- ============================= -->
  <!-- 雷达 (假设一个圆柱几何)       -->
  <!-- ============================= -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>

    <visual>
      <!-- 简单用一个圆柱表示雷达，本例假设 高=0.05m, 半径=0.03m 等 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- 雷达关节：固定在机身顶部某点 (x=0.055, y=0, z=0.2737) -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.055 0 0.2737" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

</robot>
