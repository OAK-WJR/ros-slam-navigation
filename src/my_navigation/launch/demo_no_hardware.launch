<launch>
  <!--
    No-hardware demo, added in Nov 2026 so a reviewer can run the planning part
    without the robot. It loads a saved school map, holds the robot still at the
    map origin (fixed TF instead of odometry and lidar_loc), and runs move_base
    with global_planner + my_planner. Pick a goal with "2D Nav Goal" in RViz:
    move_base plans a route and my_planner prints velocity commands on /cmd_vel.
    Nothing drives, because no robot is connected.
  -->
  <arg name="map" default="$(find my_navigation)/maps/map_school_4.yaml" />
  <arg name="rviz" default="true" />

  <param name="/use_sim_time" value="false" />

  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map)" />

  <!-- Test-robot model (Boe-Bot based platform) -->
  <param name="robot_description" textfile="$(find my_navigation)/urdf/robot.urdf" />
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" />

  <!-- Fixed pose: map -> odom -> base_link (stands in for odometry + localization) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="odom_to_base" args="0 0 0 0 0 0 odom base_link" />

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find my_navigation)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_navigation)/config/local_costmap_params.yaml" command="load" />
    <rosparam>
      global_costmap:
        robot_radius: 0.15
        inflation_layer: {inflation_radius: 0.3}
      local_costmap:
        robot_radius: 0.15
      GlobalPlanner:
        use_quadratic: true
        use_grid_path: false
        old_navfn_behavior: false
    </rosparam>
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    <param name="base_local_planner" value="my_planner/MyPlanner" />
    <param name="controller_frequency" value="10.0" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find my_navigation)/rviz/navigation.rviz" />
</launch>
