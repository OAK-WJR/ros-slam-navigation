<launch>
  <!-- 启动地图服务器 -->
  <include file="$(find my_navigation)/launch/map_server.launch" />

  <node pkg="jie_ware" type="lidar_loc" name="lidar_loc" output="screen">
    <param name="base_frame" value="base_link" />
    <param name="odom_frame" value="odom" />
    <param name="laser_frame" value="laser" />
    <param name="laser_topic" value="/scan" />
  </node>

  <node pkg="jie_ware" type="costmap_cleaner" name="costmap_cleaner" />

  <!-- 启动 Move Base -->
  <include file="$(find my_navigation)/launch/move_base.launch" />  

  <!-- 等待10秒 -->
  <arg name="wait_time" value="10"/>
  <node pkg="my_navigation" type="wait_node.py" name="wait_node" args="$(arg wait_time)" output="screen"/>

  <!-- 启动a1 -->
  <include file="$(find rplidar_ros)/launch/rplidar_a1.launch" />

  <!-- 启动tf -->
  <node pkg="tf" type="static_transform_publisher" name="laser_broadcaster" args="0 0 0 -3.14159 0 0 base_link laser 100" />

  <!-- 再等待5秒 -->
  <arg name="wait_time_2" value="10"/>
  <node pkg="my_navigation" type="wait_node.py" name="wait_node_2" args="$(arg wait_time_2)" output="screen"/>

  <!-- 启动rviz -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find my_navigation)/rviz/navigation.rviz" />
</launch>
