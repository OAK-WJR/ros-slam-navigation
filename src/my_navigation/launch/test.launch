<launch>
  <node name="controller_manager" pkg="controller_manager" type="controller_manager" output="screen">
    <param name="robot_description" command="$(find xacro)/xacro $(find my_navigation)/urdf/robot.urdf" />
    <rosparam file="$(find my_navigation)/config/diff_drive_controller.yaml" command="load" />
  </node>
</launch>
