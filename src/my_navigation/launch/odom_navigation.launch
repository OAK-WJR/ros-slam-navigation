<launch>
  <!-- Disable sim time -->
  <param name="/use_sim_time" value="false" />

  <!-- NetworkTables server IP (RoboRIO) -->
  <arg name="server_ip" default="10.1.14.2" />

  <!-- Planner params (can be overridden from the command line) -->
  <arg name="base_global_planner" default="global_planner/GlobalPlanner" />
  <arg name="base_local_planner" default="my_planner/MyPlanner" />

  <!-- Start the map server -->
  <include file="$(find my_navigation)/launch/map_server.launch" />

  <!-- Publish robot info -->
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find drivebase_urdf)/urdf/drivebase_urdf.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />

  <!-- Start imu -->
  <node pkg="my_navigation" type="imu_receive.py" name="imu_receive" output="screen" />

  <!-- Start odom -->
  <node pkg="my_navigation" type="odom_receive_nt.py" name="odom_receive_nt" output="screen">
    <param name="server_ip" value="$(arg server_ip)" />
  </node>

  <!-- Send cmd_vel -->
  <node pkg="my_navigation" type="cmd_vel_sent_nt.py" name="cmd_vel_sent_nt" output="screen">
    <param name="server_ip" value="$(arg server_ip)" />
  </node>

  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="static_transform_publisher" args="0 0 0 0 0 0 odom map" /> -->
  <node pkg="my_navigation" type="map_to_odom_broadcaster.py" name="map_to_odom_broadcaster" output="screen" />

  <!-- Load Move Base -->
  <include file="$(find my_navigation)/launch/move_base.launch">
    <arg name="base_global_planner" value="$(arg base_global_planner)" />
    <arg name="base_local_planner" value="$(arg base_local_planner)" />
  </include>

  <!-- Start RViz -->
  <node name="rviz" pkg="rviz" type="rviz"
    args="-d $(find my_navigation)/config/rviz_config.rviz" />
</launch>
