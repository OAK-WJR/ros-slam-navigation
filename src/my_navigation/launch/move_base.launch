<launch>
    <!-- 允许通过 launch 参数切换规划器（不改代码即可对比效果） -->
    <arg name="base_global_planner" default="global_planner/GlobalPlanner" />
    <arg name="base_local_planner" default="my_planner/MyPlanner" />

    <node pkg="move_base" type="move_base" name="move_base" output="screen"
          respawn="true" respawn_delay="5.0">
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_costmap_params.yaml" command="load" />

        <!-- 全局路径更平滑/转弯更少（对 ROS1 的 global_planner/GlobalPlanner 生效） -->
        <rosparam>
          GlobalPlanner:
            use_quadratic: true
            use_grid_path: false
            old_navfn_behavior: false
        </rosparam>

        <param name="base_global_planner" value="$(arg base_global_planner)" />
        <param name="base_local_planner" value="$(arg base_local_planner)" />
        <param name="controller_frequency" value="30.0" />
    </node>
</launch>
