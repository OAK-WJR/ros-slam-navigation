<launch>
  <!-- Start the robot control nodes -->
  <include file="$(find my_navigation)/launch/robot_control.launch" />

  <!-- Start differential drive control -->
  <!-- <include file="$(find my_navigation)/launch/diff_drive.launch" /> -->

  <!-- Start RPLIDAR A1 -->
  <!-- <include file="$(find rplidar_ros)/launch/rplidar_a1.launch" /> -->

  <!-- Start the custom odometry publisher node -->
  <node pkg="my_navigation" type="diffdrive_odom_publisher.py" name="diffdrive_odom_publisher" output="screen" />

  <!-- Wait 5 seconds -->
  <arg name="wait_time" value="5"/>
  <node pkg="my_navigation" type="wait_node.py" name="wait_node" args="$(arg wait_time)" output="screen"/>

  <!-- Start the robot control node -->
  <node pkg="my_navigation" type="robotControll.py" name="robotControll" output="screen" />
</launch>
